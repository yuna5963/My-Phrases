# Notion Internal Integration token (used only by `npm run sync`, never shipped to the client)
# 1. Create an integration at https://www.notion.so/my-integrations
# 2. Share the "🔠 フレーズ集" database with that integration
# 3. Copy the token here as .env
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Data source (collection) ID of the フレーズ集 DB
NOTION_DATA_SOURCE_ID=37ad60c3-814b-807f-a288-000b36b3b8cd
