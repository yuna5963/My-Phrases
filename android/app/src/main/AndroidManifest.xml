<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 連続再生のバックグラウンド継続用フォアグラウンドサービス。
             stopWithTask=true は必須: 既定(false)だと、再生中にタスク一覧から
             アプリをスワイプで閉じてもサービスが生き残り、プロセス常駐と
             PARTIAL_WAKE_LOCK 保持（＝CPUが眠れない）が続いてしまう。
             Activity が消えた時点で再生を進める JS も無く、実体のない
             「再生中」通知だけが残る状態になる。 -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="mediaPlayback"
        />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 意味ノード英語思考（STEP1/STEP2）の音声入力用マイク権限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- CSV/バックアップの公開 Documents フォルダ保存用。Android 11+ は権限不要のため ≤10 に限定 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
</manifest>
